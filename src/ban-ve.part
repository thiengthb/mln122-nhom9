<!-- Bản nháp B: khung bản vẽ, nét tự kẻ, số đếm lên, sơ đồ tự lắp. Chạy sau app.part và GSAP. Không sửa app.part. -->
<script>
(()=>{
if(PRES||!window.gsap)return;
const NS="http://www.w3.org/2000/svg",stage=$("#stage"),motion=!reduce;
const el=(tag,at={},par)=>{const e=document.createElementNS(NS,tag);for(const k in at)e.setAttribute(k,at[k]);if(par)par.append(e);return e};

/* Đã bỏ khung viền ngoài theo góp ý của người dùng (04/11/2026). */

/* 2. Góc tờ (chỉ chữ: người nói, số tờ) và sợi chỉ chạy hết đáy slide: đoạn đã đi tô màu, chấm là chỗ đổi người nói */
const tb=document.createElement("div");tb.id="tb";tb.setAttribute("aria-hidden","true");
tb.innerHTML=`<span id="tbw"></span><span id="tbn"></span>`;
stage.insertBefore(tb,$("#notes"));
const TH=document.createElement("div");TH.id="th2";TH.setAttribute("aria-hidden","true");
const TX=i=>30+1540*i/(slides.length-1);
let td="M30 16";for(let x=30,k=0;x<1570;x+=26,k++){const nx=Math.min(x+26,1570);td+=` Q${(x+nx)/2} ${k%2?22:10} ${nx} 16`}
const tf=[];slides.forEach((s,j)=>{if(!j||s.dataset.who!==slides[j-1].dataset.who)tf.push(j)});
TH.innerHTML=`<svg viewBox="0 0 1600 32"><path class="tb0" d="${td}"/><path class="tb1" id="tbp" d="${td}" pathLength="100"/>${tf.map(j=>`<circle data-j="${j}" cx="${TX(j)}" cy="16" r="6"/>`).join("")}</svg>`;
stage.insertBefore(TH,$("#notes"));
function tbSet(i){const s=slides[i];$("#tbw").textContent="Người "+s.dataset.who;
 $("#tbn").textContent=String(i+1).padStart(2,"0")+" / "+slides.length;
 const p=slides.length>1?i/(slides.length-1)*100:0;$("#tbp").style.strokeDasharray=`${p} 200`;
 $$("#th2 circle").forEach(c=>c.classList.toggle("on",+c.dataset.j<=i))}

/* 2b. Số câu hỏi rất lớn, nét viền mờ ở góc phải trên (chỉ ở ba phần câu hỏi) */
slides.forEach(s=>{const a=+s.dataset.act;if(!(a>=1&&a<=3))return;const g=el("svg",{class:"ghostn",viewBox:"0 0 300 300","aria-hidden":"true"});
 el("line",{x1:-40,y1:198,x2:200,y2:198},g);const t=el("text",{x:200,y:190,"text-anchor":"end"},g);t.textContent=a;
 const l=el("text",{class:"gl",x:52,y:190,"text-anchor":"end"},g);l.textContent="CÂU HỎI";s.prepend(g)});

/* 2c. Tách tiêu đề thành từng từ; các từ trong một cụm (đến dấu phẩy, hai chấm, chấm hỏi, xuống dòng, phần in màu) hiện cùng lúc */
function split(h){if(h.dataset.k)return+h.dataset.k;let k=0,has=false;
 const walk=n=>{[...n.childNodes].forEach(c=>{
  if(c.nodeType===3){const f=document.createDocumentFragment();
   c.textContent.split(/(\s+)/).forEach(t=>{if(!t)return;if(/^\s+$/.test(t)){f.append(t);return}
    const w=document.createElement("span");w.className="w";const wi=document.createElement("span");wi.className="wi";wi.textContent=t;wi.dataset.k=k;w.append(wi);f.append(w);has=true;
    if(/[,;:?.!]["”]?$/.test(t)){k++;has=false}});c.replaceWith(f)}
  else if(c.nodeName==="BR"){if(has){k++;has=false}}
  else if(c.nodeName==="EM"){if(has){k++;has=false}walk(c);if(has){k++;has=false}}
  else walk(c)})};
 walk(h);h.dataset.k=k+1;return k+1}
$$(".s h1,.s h2").forEach(split);
function heads(s,t0,root){const tl=gsap.timeline({delay:t0});
 $$("h1,h2",root||s).forEach((h,j)=>{const n=+h.dataset.k||split(h),at=j*.45;
  for(let k=0;k<n;k++){const ws=$$(`.wi[data-k="${k}"]`,h);if(ws.length)tl.fromTo(ws,{yPercent:118},{yPercent:0,duration:.55,ease:"power3.out",stagger:.03},at+k*.3)}});
 return tl}

/* 3. Viền khối do JS kẻ, để có thể vẽ dần */
const OL=".panel,.leaf,.fork,.wc,.shift span,.chain b,.view";
function outline(root){$$(OL,root).forEach(b=>{if(b.querySelector(":scope>svg.ol"))return;const s=el("svg",{class:"ol","aria-hidden":"true"});el("rect",{x:0,y:0,width:"100%",height:"100%",pathLength:1},s);b.prepend(s)})}
outline(stage);new MutationObserver(()=>outline($("#plan"))).observe($("#plan"),{childList:true});

/* 4. Bánh răng ở tâm sơ đồ */
function gearPath(n=18,R=146,r=130,c=150){let d="";for(let k=0;k<n;k++){const a=k/n*2*Math.PI,w=Math.PI/n;
  const p=[[r,a-w*.55],[R,a-w*.32],[R,a+w*.32],[r,a+w*.55]].map(([q,t])=>`${(c+q*Math.cos(t)).toFixed(1)} ${(c+q*Math.sin(t)).toFixed(1)}`);
  d+=(k?" L":"M")+p.join(" L")}return d+"Z"}
$$(".gearbox").forEach(g=>{const s=el("svg",{viewBox:"0 0 300 300","aria-hidden":"true"});el("path",{class:"gear",d:gearPath()},s);
 el("circle",{cx:150,cy:150,r:112,style:"fill:none;stroke:var(--son);stroke-width:1.2;stroke-dasharray:3 6"},s);g.prepend(s)});

/* 5. Vạch chia: trục năm và mặt đồng hồ mục tiêu */
$$(".tks").forEach(g=>{for(let y=0;y<=80;y+=5){const x=10+y*10;el("line",{class:"d-ax",x1:x,y1:y%10?27:22,x2:x,y2:32},g)}});
/* Slide 18: bản B giữ mặt đồng hồ như trước (người dùng chọn), dùng dữ liệu G mới của bản chính */
(()=>{const gz=$("#gauges");if(!gz)return;gz.innerHTML=G.map(g=>{const p=Math.min(1,g[2]/g[3]),C=2*Math.PI*78;return`<div class="panel gc"><h3 style="font-size:25px;min-height:58px">${g[0]}</h3><svg viewBox="0 0 200 200" style="width:100%;max-width:230px;align-self:center"><circle class="gt" cx="100" cy="100" r="78" fill="none" stroke-width="20"/><circle class="arc" cx="100" cy="100" r="78" fill="none" stroke-width="20" transform="rotate(-90 100 100)" stroke-dasharray="${C}" style="stroke:var(${g[10]});--o:${C};--to:${C*(1-p)}"/><text class="gv" x="100" y="98" text-anchor="middle" font-size="34" font-weight="800" font-family="var(--display)">${g[4]}</text><text class="gs" x="100" y="124" text-anchor="middle" font-size="15">${g[5]}</text></svg><p style="font-size:24px">Mốc 2030: <b class="n" data-c="${g[9]}">${g[6]}</b></p><p class="sm" style="font-size:18px">Đơn vị: ${g[1]}. <span class="n" data-c="${g[8]}">Nguồn số hiện tại</span>. Mốc theo ${g[7]}.${g[11]?" "+g[11][0].toUpperCase()+g[11].slice(1)+".":""}</p></div>`}).join("")})();
$$("#gauges .gc svg:not(.ol)").forEach(s=>{const g=el("g",{class:"tk2"},s);for(let k=0;k<40;k++){const a=k/40*2*Math.PI,l=k%5?4:9;
 el("line",{x1:100+96*Math.sin(a),y1:100-96*Math.cos(a),x2:100+(96+l)*Math.sin(a),y2:100-(96+l)*Math.cos(a)},g)}
 el("path",{class:"tgt",d:"M100 -9 l-7 -11 h14z"},s)});

/* 6. Cán cân c/v trong mô phỏng: đĩa trái là máy móc, nguyên liệu (c), đĩa phải là tiền công (v).
   Mỗi hình là 20 đơn vị giá trị của mô hình giả định; hình cuối được cắt theo phần lẻ. Cán cân nghiêng theo (c − v)/(c + v). */
(()=>{const p=$("#simA").closest(".panel"),w=document.createElement("div");w.id="cvw";p.append(w);
 const ROB='<path d="M2 22h12M8 22v-4M8 18 5.5 10.5M5.5 10.5 14 5.5M14 5.5l3.6-2.4M14 5.5l3.8 1.4"/><circle cx="5.5" cy="10.5" r="1.7"/><circle cx="8" cy="18" r="1.7"/>',
  MAN='<circle cx="12" cy="5.6" r="3.6"/><path d="M5.5 22.5v-6a6.5 6.5 0 0 1 13 0v6"/>',ST=20,U=20,BY=104,AR=122;
 w.innerHTML=`<svg viewBox="0 0 400 178" aria-label="Cán cân: bên trái máy móc, nguyên liệu (c), bên phải tiền công (v)"><defs><clipPath id="cpc"><rect y="-62" height="60"/></clipPath><clipPath id="cpv"><rect y="-62" height="60"/></clipPath></defs>
  <path class="fu" d="M200 ${BY} L186 158 H214 Z"/><line class="ax" x1="160" y1="158" x2="240" y2="158"/>
  <g class="bm"><line class="beam" x1="${-AR}" y1="0" x2="${AR}" y2="0"/><g class="pan" data-k="c"><line class="post" y1="0" y2="-24"/><path class="plate" d="M-76 -24 H76"/><g class="ico" clip-path="url(#cpc)"></g><text class="pl" y="22" text-anchor="middle">c · máy móc</text></g><g class="pan" data-k="v"><line class="post" y1="0" y2="-24"/><path class="plate" d="M-76 -24 H76"/><g class="ico" clip-path="url(#cpv)"></g><text class="pl" y="22" text-anchor="middle">v · tiền công</text></g></g>
  <circle class="piv" cx="200" cy="${BY}" r="5"/>
  <text class="ratio" x="200" y="16" text-anchor="middle"></text><text class="key" x="398" y="176" text-anchor="end">mỗi hình = 20 đơn vị (giả định)</text></svg>`;
 const sv=$("svg",w),pans=$$(".pan",w),rt=$(".ratio",w),cl={c:$("#cpc rect",w),v:$("#cpv rect",w)},cnt={c:-1,v:-1},S={t:0};
 const icons=(g,k,val)=>{const n=Math.ceil(val/U-1e-6),x0=-(n*ST)/2;
  if(n!==cnt[k]){const old=cnt[k];g.innerHTML=Array.from({length:n},(_,j)=>`<g class="i${j>=old&&old>=0?" in":""}" transform="translate(${x0+j*ST} -46) scale(.9)">${k==="c"?ROB:MAN}</g>`).join("");cnt[k]=n}
  cl[k].setAttribute("x",x0);cl[k].setAttribute("width",Math.max(0,val/U*ST))};
 const draw=()=>{const th=S.t,cx=Math.cos(th),sn=Math.sin(th);
  $(".bm",w).setAttribute("transform",`translate(200 ${BY}) rotate(${-th*180/Math.PI})`);
  pans.forEach((g,j)=>{const x=(j?1:-1)*AR;g.setAttribute("transform",`translate(${x} 0) rotate(${th*180/Math.PI})`)})};
 let tw=null;const upd=()=>{const a=+$("#simA").value/100,o=window.__sim(a,false);icons($(".ico",pans[0]),"c",o.c);icons($(".ico",pans[1]),"v",o.v);
  rt.textContent=`c/v = ${fmt(o.r,2)}`;const t=((o.c-o.v)/(o.c+o.v))*20*Math.PI/180;
  if(tw)tw.kill();if(window.gsap&&!reduce){tw=gsap.to(S,{t,duration:.5,ease:"power2.out",onUpdate:draw})}else{S.t=t;draw()}};
 const base=runSim;window.runSim=function(){base();upd()};runSim=window.runSim;upd()})();

/* 6b. Slide 16: cửa ra vào cạnh nhãn từng cột: người bước vào (tạo mới), bước ra (mất đi), thêm một người (tăng thêm) */
(()=>{const wb=$$(".wfall .wb");if(wb.length!==3)return;
 const DOOR='<path class="dr" d="M20 22V3h9v19"/><path class="fl" d="M1 22h31"/>',
  MAN='<g class="wk"><circle cx="0" cy="5" r="2.4"/><path d="M0 8l-.8 6.5M-.8 14.5-3.6 21.5M-.8 14.5 2.2 21.5M-.2 10-3.4 13M-.2 10 3 12.6"/></g>';
 const ic=[["in",'<path class="ar" d="M13 12l3 0M14.6 10.2 16.6 12 14.6 13.8"/>'],["out",'<path class="ar" d="M7 12H2.5M4.1 10.2 2.1 12 4.1 13.8"/>'],["plus",'<path class="ar" d="M12 8v8M8 12h8"/>']];
 wb.forEach((b,j)=>{const sp=b.querySelector("span");if(!sp||sp.querySelector("svg"))return;const [k,ex]=ic[j];
  sp.insertAdjacentHTML("afterbegin",`<svg class="door ${k}" viewBox="0 0 33 24" aria-hidden="true">${k==="plus"?"":DOOR}${ex}${MAN.replace('class="wk"',`class="wk" style="--d:${1.6+j*1.2}s"`)}</svg>`)})})();

/* 7. Nét nối sơ đồ: từ data-links="a>b,c>d!" (! là nét nhấn) */
function box(e,root){let x=0,y=0,n=e;while(n&&n!==root){x+=n.offsetLeft;y+=n.offsetTop;n=n.offsetParent}return{x,y,w:e.offsetWidth,h:e.offsetHeight}}
function elbow(sx,sy,ex,ey,vert){const r=12;
 if(vert){if(Math.abs(ex-sx)<2)return`M${sx} ${sy} V${ey}`;const my=(sy+ey)/2,k=Math.min(r,Math.abs(ex-sx)/2,(ey-sy)/2),dx=Math.sign(ex-sx);
  return`M${sx} ${sy} V${my-k} Q${sx} ${my} ${sx+dx*k} ${my} H${ex-dx*k} Q${ex} ${my} ${ex} ${my+k} V${ey}`}
 if(Math.abs(ey-sy)<2)return`M${sx} ${sy} H${ex}`;const mx=(sx+ex)/2,k=Math.min(r,Math.abs(ey-sy)/2,(ex-sx)/2),dy=Math.sign(ey-sy);
 return`M${sx} ${sy} H${mx-k} Q${mx} ${sy} ${mx} ${sy+dy*k} V${ey-dy*k} Q${mx} ${ey} ${mx+k} ${ey} H${ex}`}
function links(s){if(!s.dataset.links)return[];let sv=s.querySelector(":scope>svg.links");if(sv)sv.remove();
 sv=el("svg",{class:"links",viewBox:"0 0 1600 900","aria-hidden":"true"});s.prepend(sv);
 return s.dataset.links.split(",").map(t=>{const acc=t.endsWith("!"),[a,b]=t.replace("!","").split(">"),A=box($("#"+a,s),s),B=box($("#"+b,s),s);
  const vert=B.y>=A.y+A.h-2&&B.x<A.x+A.w;let sx,sy,ex,ey;
  if(vert){sx=A.x+A.w/2;sy=A.y+A.h;ex=B.x+B.w/2;ey=B.y-2}else{sx=A.x+A.w;sy=A.y+A.h/2;ex=B.x-2;ey=B.y+B.h/2}
  const p=el("path",{d:elbow(sx,sy,ex,ey,vert),class:acc?"a":"","marker-end":`url(#${acc?"dap":"da"})`},sv);const c=el("circle",{cx:sx,cy:sy,r:4},sv);return{p,c}})}

/* 8. Vẽ dần một đường bằng mặt nạ, để cả nét đứt và đầu mũi tên cũng hiện theo */
let mid=0;function maskFor(p){if(p.__m)return p.__m;const sv=p.ownerSVGElement;let defs=sv.querySelector("defs")||el("defs",{},sv);
 const m=el("mask",{id:"mk"+(++mid),maskUnits:"userSpaceOnUse",x:-100,y:-100,width:2200,height:1200},defs);
 const q=el("path",{d:p.getAttribute("d"),fill:"none",stroke:"#fff","stroke-width":34,"stroke-linecap":"round","stroke-linejoin":"round"},m);
 p.setAttribute("mask",`url(#${m.id})`);const L=q.getTotalLength();q.style.strokeDasharray=L+" "+L;return p.__m={q,L}}
function draw(p,dur,delay,pen=true){const m=maskFor(p),z={f:0},P=p.getTotalLength();let tip=null;m.q.style.strokeDashoffset=m.L;
 if(pen&&motion){tip=el("circle",{class:"tip",r:5},p.ownerSVGElement);tip.style.opacity=0}
 const end=()=>{if(tip){const t=tip;tip=null;gsap.to(t,{opacity:0,duration:.3,onComplete:()=>t.remove()})}};
 return gsap.to(z,{f:1,duration:dur,delay,ease:"power1.inOut",onStart(){if(tip)tip.style.opacity=1},
  onUpdate(){m.q.style.strokeDashoffset=m.L*(1-z.f);if(tip){const q=p.getPointAtLength(P*z.f);tip.setAttribute("cx",q.x);tip.setAttribute("cy",q.y)}},onComplete:end,onInterrupt:end})}

/* 9. Số đếm lên, giữ đúng cách viết 1.220 · 4,53 · −48,34% · 2,2 triệu */
const CNT=".big,.bar>span:last-child,.wb b,.lgt b.n,.cnt,.gv";
function count(e,delay){if(e.children.length)return null;const o=e.dataset.o||(e.dataset.o=e.textContent);
 const m=o.match(/^([^\d]*?)(\d{1,3}(?:\.\d{3})+|\d+)(?:,(\d+))?(.*)$/);if(!m)return null;
 const th=m[2].includes("."),dec=m[3]?m[3].length:0,v=parseFloat(m[2].replace(/\./g,"")+(m[3]?"."+m[3]:"")),z={v:0};
 const f=x=>{let s=x.toFixed(dec).split(".");if(th)s[0]=s[0].replace(/\B(?=(\d{3})+(?!\d))/g,".");return m[1]+s[0]+(dec?","+s[1]:"")+m[4]};
 e.textContent=f(0);return gsap.to(z,{v,duration:1.5,delay,ease:"power2.out",onUpdate(){e.textContent=f(z.v)},onComplete(){e.textContent=o}})}

/* 10. Vào slide: khung tên, viền khối, nét kích thước, nét nối, số */
let live=[];
function enter(i){live.forEach(t=>t.kill());live=[];const s=slides[i];tbSet(i);
 const lk=links(s);
 if(!motion)return;
 const rects=$$("svg.ol rect",s).filter(r=>!r.closest(".st,[hidden]"));
 live.push(gsap.fromTo(rects,{strokeDasharray:"1 1",strokeDashoffset:1},{strokeDashoffset:0,duration:.9,ease:"power2.inOut",stagger:.05,delay:.25}));
 $$("path.dr",s).forEach(p=>live.push(draw(p,+p.dataset.d||1.4,+p.dataset.w||.4)));
 $$(".gr",s).forEach(r=>{const w=r.getAttribute("width");r.dataset.w=r.dataset.w||w;live.push(gsap.fromTo(r,{attr:{width:0}},{attr:{width:r.dataset.w},duration:.7,delay:/p/.test(r.className.baseVal)?2.3:2.3,ease:"power2.out"}))});
 live.push(gsap.fromTo($$(".ex,.d-tx,.st-dot,.st-t",s),{opacity:0},{opacity:1,duration:.4,stagger:.08,delay:1}));
 lk.forEach((l,k)=>{const t=draw(l.p,.7,1+k*.12);if(l.p.classList.contains("a"))t.eventCallback("onComplete",()=>l.p.classList.add("flow"));live.push(t);live.push(gsap.fromTo(l.c,{opacity:0},{opacity:1,duration:.2,delay:1+k*.12}))});
 const gh=s.querySelector(":scope>svg.ghostn"),h2=s.querySelector("h2");if(gh&&h2){const S=s.getBoundingClientRect(),k=S.width/1600,rg=document.createRange();rg.selectNodeContents(h2);gh.style.display=[...rg.getClientRects()].some(q=>(q.right-S.left)/k>1320&&(q.top-S.top)/k<230)?"none":""}
 if(gh&&gh.style.display!=="none"){const t=gh.querySelector("text");live.push(gsap.fromTo(t,{strokeDasharray:"1400 1400",strokeDashoffset:1400},{strokeDashoffset:0,duration:2.4,ease:"power1.inOut",delay:.3}));
  live.push(gsap.fromTo($$("line,.gl",gh),{opacity:0},{opacity:1,duration:.6,delay:1.2}))}
 const bb=$$(".bub",s);if(bb.length)live.push(gsap.fromTo(bb,{scale:0,rotate:-90},{scale:1,rotate:0,duration:.55,ease:"back.out(2.2)",stagger:.14,delay:.9,clearProps:"transform"}));
 $$(".d-tx",s).forEach(e=>{const o=e.dataset.o||(e.dataset.o=e.textContent),m=o.match(/^(\d+)–(\d+)(.*)$/);if(!m)return;const z={v:0};
  live.push(gsap.to(z,{v:1,duration:1.4,delay:1.1,ease:"power2.out",onUpdate(){e.textContent=Math.round(m[1]*z.v)+"–"+Math.round(m[2]*z.v)+m[3]},onComplete(){e.textContent=o}}))});
 $$(CNT,s).forEach((e,k)=>{const t=count(e,.5+k*.08);if(t)live.push(t)});
 extras(s);live.push(heads(s,.1));
 if(s.querySelector(".gearbox"))live.push(gsap.fromTo($$(".gearbox",s),{scale:.6,opacity:0},{scale:1,opacity:1,duration:.8,ease:"back.out(1.6)",delay:.4}))}

/* 10b. Chi tiết riêng từng slide */
// Dấu khác: hai gạch ngang rồi nét chéo
$$(".neq").forEach(n=>{n.innerHTML=`<svg viewBox="0 0 80 100" aria-hidden="true"><path pathLength="1" d="M10 40 H70"/><path pathLength="1" d="M10 62 H70"/><path pathLength="1" d="M56 14 L24 88"/></svg>`});
function along(p,cls,dur,delay,ease){const sv=p.ownerSVGElement,c=el("circle",{class:cls,r:7},sv),P=p.getTotalLength(),z={f:0};c.style.opacity=0;
 const t=gsap.to(z,{f:1,duration:dur,delay,ease,onStart(){c.style.opacity=1},onUpdate(){const q=p.getPointAtLength(P*z.f);c.setAttribute("cx",q.x);c.setAttribute("cy",q.y)},onInterrupt(){c.remove()}});t.dot=c;return t}
function extras(s){
 // Mặt cắt gạch chéo quét từ trái sang sau khi viền kẻ xong
 const dk=$$(".panel.dark,.leaf.hc",s);if(dk.length)live.push(gsap.fromTo(dk,{"--hx":"100%"},{"--hx":"0%",duration:.8,ease:"power2.out",stagger:.12,delay:1.05}));
 // Dấu khác ở slide 13
 const nq=$$(".neq path",s);if(nq.length)live.push(gsap.fromTo(nq,{strokeDashoffset:1},{strokeDashoffset:0,duration:.35,stagger:.3,delay:1.2,ease:"power2.inOut"}));
 // Bậc thang: một chấm leo từng bậc; ở slide 3 có thêm chấm "đi tắt" bay theo đường đứt
 $$("path.st-step",s).forEach(st=>{const sv=st.ownerSVGElement;$$(".climb,.jumper",sv).forEach(e=>e.remove());
  const pts=st.getAttribute("d").match(/[\d.]+ [\d.]+/g).map(v=>v.split(" ").map(Number));
  const c=el("circle",{class:"climb",r:8,cx:pts[0][0],cy:pts[0][1]},sv);c.style.opacity=0;
  const jp=st.classList.contains("dr")?sv.querySelector("path.st-jump"):null;
  const t0=(+st.dataset.w||0)+(+st.dataset.d||1.4)+.4,tl=gsap.timeline({delay:t0,repeat:-1,repeatDelay:1.4});
  if(jp){const j=el("circle",{class:"jumper",r:7},sv);j.style.opacity=0;const P=jp.getTotalLength(),z={f:0};
   tl.set(j,{opacity:1}).fromTo(z,{f:0},{f:1,duration:1,ease:"power2.in",onUpdate(){const q=jp.getPointAtLength(P*z.f);j.setAttribute("cx",q.x);j.setAttribute("cy",q.y)}}).to(j,{opacity:.35,duration:.3})}
  tl.set(c,{opacity:1,attr:{cx:pts[0][0],cy:pts[0][1]}});
  pts.slice(1).forEach(q=>tl.to(c,{attr:{cx:q[0],cy:q[1]},duration:.2,ease:"power1.inOut"}));
  tl.to(c,{attr:{r:12},duration:.2,yoyo:true,repeat:1}).to(sv.querySelectorAll(".climb,.jumper"),{opacity:0,duration:.4,delay:.9});
  live.push(tl)});
 // Slide 7: ngòi bút chạy theo ba con đường, đúng nhịp nét đang vẽ
 const ws=$$("#waysvg .way",s);if(ws.length){$$("#waysvg .pen,#waysvg .ring").forEach(e=>e.remove());
  [[ws[0],"pen p0",0,3.2],[ws[1],"pen p1",3.4,1.4],[ws[2],"pen p2",5.2,3.8]].forEach(([p,c,d,u])=>{const t=along(p,c,u,d,"power1.inOut");live.push(t);live.push(gsap.to(t.dot,{opacity:0,duration:.3,delay:d+u+.1}))});
  const rg=el("circle",{class:"ring",cx:880,cy:70,r:9},$("#waysvg"));live.push(gsap.fromTo(rg,{attr:{r:9},opacity:.9},{attr:{r:30},opacity:0,duration:1.1,repeat:2,delay:9.1,ease:"power1.out"}))}
 $$("#gauges .gc",s).forEach((g,j)=>{const x=G[j],p=Math.min(1,x[2]/x[3]),tk=$$(".tk2 line",g),gg=g.querySelector(".tk2");if(!gg)return;gg.style.setProperty("--c",`var(${x[10]})`);
  tk.forEach((l,k)=>{l.removeAttribute("data-on");const f=k/40;if(f>p)return;live.push(gsap.to(l,{duration:0,delay:.5+1.8*(1-Math.sqrt(1-f/p))*p,attr:{"data-on":1}}))})})
}

/* 10d. Slide 4: bốn hình thu nhỏ lại thành một quá trình 1 → 2, nối xuống 3 → 4 */
(()=>{const cv=$("#morph");if(!cv)return;const fig=cv.closest("figure"),rv=$$("#revlist .rv"),i4=slides.findIndex(s=>s.dataset.title==="Bốn cuộc cách mạng");
 const ov=document.createElement("div");ov.className="proc";ov.setAttribute("aria-hidden","true");fig.append(ov);
 let snaps=[],tmr=null,tl=null;
 const snap=j=>{const c=document.createElement("canvas");c.width=cv.width;c.height=cv.height;c.getContext("2d").drawImage(cv,0,0);snaps[j]=c};
 const reset=()=>{clearTimeout(tmr);tmr=null;if(tl)tl.kill();snaps=[];ov.innerHTML="";ov.classList.remove("on");gsap.set(cv,{clearProps:"transform,opacity"})};
 new MutationObserver(()=>{const j=rv.findIndex(e=>e.classList.contains("on"));if(j<0||cur!==i4)return;
  if(j===0){reset();return}if(!snaps[j-1])snap(j-1);
  if(j===3&&!tmr){tmr=setTimeout(()=>{snap(3);build()},1800+1600)}}).observe($("#revlist"),{subtree:true,attributes:true,attributeFilter:["class"]});
 function build(){if(cur!==i4||!motion||snaps.filter(Boolean).length<4)return;
  const H=cv.offsetHeight,W=cv.offsetWidth;ov.style.height=H+"px";ov.classList.add("on");
  ov.innerHTML=rv.map((r,j)=>`<div class="pc pc${j}"><div class="ph"></div><div class="pt"><b>${j+1}</b><span>${r.querySelector("h3").textContent}</span></div></div>`).join("")+`<svg class="pl" aria-hidden="true"></svg>`;
  $$(".ph",ov).forEach((p,j)=>{snaps[j].className="";p.append(snaps[j])});
  const sv=$(".pl",ov);sv.setAttribute("viewBox",`0 0 ${ov.offsetWidth} ${H}`);
  const B=$$(".pc",ov).map(c=>box(c.querySelector(".ph"),ov)),cell=$$(".pc",ov);
  const mk=(d,cls)=>el("path",{d,class:cls,"marker-end":"url(#dap)"},sv);
  const l1=mk(`M${B[0].x+B[0].w+6} ${B[0].y+B[0].h/2} H${B[1].x-8}`,"a"),
   sy2=B[1].y+B[1].h+30,my=(sy2+B[2].y-6)/2,l2=mk(`M${B[1].x+B[1].w/2} ${sy2} V${my-12} Q${B[1].x+B[1].w/2} ${my} ${B[1].x+B[1].w/2-12} ${my} H${B[2].x+B[2].w/2+12} Q${B[2].x+B[2].w/2} ${my} ${B[2].x+B[2].w/2} ${my+12} V${B[2].y-6}`,"a"),
   l3=mk(`M${B[2].x+B[2].w+6} ${B[2].y+B[2].h/2} H${B[3].x-8}`,"a");
  const sc=B[3].w/W;
  tl=gsap.timeline()
   .set(cell,{opacity:0}).set(cell[3],{opacity:1}).set(cell[3].querySelector(".pt"),{opacity:0})
   .fromTo(cell[3].querySelector(".ph"),{x:-B[3].x,y:-B[3].y,scale:1/sc,transformOrigin:"0 0"},{x:0,y:0,scale:1,duration:.8,ease:"power3.inOut"})
   .set(cv,{opacity:0},"<.05")
   .fromTo(cell[0],{opacity:0,scale:.85},{opacity:1,scale:1,duration:.4,ease:"back.out(1.8)"},"+=.05")
   .add(draw(l1,.4,0),">-.05")
   .fromTo(cell[1],{opacity:0,scale:.85},{opacity:1,scale:1,duration:.4,ease:"back.out(1.8)"},">-.1")
   .add(draw(l2,.7,0),">-.05")
   .fromTo(cell[2],{opacity:0,scale:.85},{opacity:1,scale:1,duration:.4,ease:"back.out(1.8)"},">-.1")
   .add(draw(l3,.4,0),">-.05")
   .to(cell[3].querySelector(".pt"),{opacity:1,duration:.3},">-.1")
   .fromTo(cell[3],{"--rg":"0px"},{"--rg":"6px",duration:.5,ease:"power2.out"})}
 const show1=window.show;window.show=function(i,st){if(i!==i4)reset();show1(i,st)};show=window.show})();

/* 10e. Tờ bìa phụ khi sang phần câu hỏi mới */
const QS=$$(".qs .callout h3").map(h=>h.textContent);
const iv=document.createElement("div");iv.id="iv";iv.setAttribute("aria-hidden","true");stage.insertBefore(iv,$("#notes"));
function ivFill(a){iv.innerHTML=`<div class="ivn"><svg viewBox="0 0 420 420"><text x="210" y="360" text-anchor="middle">${a}</text></svg></div>
 <div class="ivt"><div class="eb">PHẦN ${a} / 3 · CÂU HỎI ${a}</div><h2>${QS[a-1]||""}</h2><svg class="ivl" viewBox="0 0 820 30"><path d="M4 15 H816" marker-start="url(#dap)" marker-end="url(#dap)"/></svg><div class="ivw"><span>NGƯỜI NÓI</span> Người ${slides.find(s=>+s.dataset.act===a).dataset.who}</div></div>`;split(iv.querySelector("h2"))}

/* 10c. Soi nguồn: kẻ đường dẫn từ con số ra ô nguồn, như chú thích trên bản vẽ */
const LS=el("svg",{id:"lead",viewBox:"0 0 1600 900","aria-hidden":"true"});stage.append(LS);
function leader(n){LS.innerHTML="";const d=$("#drawer");if(!d.classList.contains("on")||!motion&&false)return;
 const S=stage.getBoundingClientRect(),k=S.width/1600,r=n.getBoundingClientRect(),h=d.querySelector("h3");
 const sx=((r.left+r.right)/2-S.left)/k,sy=(r.bottom-S.top)/k;if(sx>930||!h)return;
 const ty=h.offsetTop+h.offsetHeight/2,lane=Math.min(sy+18,884);
 const p=el("path",{d:`M${sx} ${sy+2} V${lane} H930 V${ty} H954`,"marker-end":"url(#dap)",pathLength:1},LS);el("circle",{cx:sx,cy:sy+2,r:4},LS);
 if(motion)gsap.fromTo(p,{strokeDasharray:"1 1",strokeDashoffset:1},{strokeDashoffset:0,duration:.6,delay:.15,ease:"power2.inOut"})}
document.addEventListener("click",e=>{const n=e.target.closest("[data-c]");if(!n||n.closest("#drawer"))return;requestAnimationFrame(()=>leader(n))},true);
new MutationObserver(()=>{if(!$("#drawer").classList.contains("on"))LS.innerHTML=""}).observe($("#drawer"),{attributes:true,attributeFilter:["class"]});

/* 11. Chuyển slide: nội dung lùi ra nhanh rồi tờ mới hiện */
const show0=show,next0=next,prev0=prev;let busy=null;
const fin=()=>{if(busy){busy.progress(1);busy=null}};
window.show=function(i,st){show0(i,st);const go2=()=>{if(cur===i)enter(i)};document.fonts&&document.fonts.status!=="loaded"?document.fonts.ready.then(go2):go2()};show=window.show;
window.next=function(){fin();next0()};next=window.next;window.prev=function(){fin();prev0()};prev=window.prev;
const wipe=document.createElement("div");wipe.id="wipe";stage.append(wipe);
window.go=function(i){i=Math.max(0,Math.min(slides.length-1,i));fin();if(i===cur)return;if(!motion){show(i);return}
 LS.innerHTML="";const back=i<cur,kids=[...slides[cur].children].filter(e=>!e.matches(".notes,.foot"));live.forEach(t=>t.kill());live=[];const ns=slides[i];
 const a=back?"inset(0 0 0 100%)":"inset(0 100% 0 0)",na=+ns.dataset.act;
 if(!back&&na>=1&&na<=3&&na!==+slides[cur].dataset.act){ivFill(na);const T=iv.querySelector(".ivn text"),L=iv.querySelector(".ivl path");
  busy=gsap.timeline({onComplete(){busy=null;gsap.set(iv,{autoAlpha:0,clearProps:"clipPath"});gsap.set(wipe,{opacity:0})}})
   .to(kids,{opacity:0,y:-14,duration:.2,stagger:.015,ease:"power2.in"})
   .set(iv,{autoAlpha:1,clipPath:"inset(0 100% 0 0)"})
   .add(()=>{gsap.set(kids,{clearProps:"opacity,transform"})})
   .to(iv,{clipPath:"inset(0 0% 0 0)",duration:.35,ease:"power2.inOut"})
   .fromTo(wipe,{x:0,opacity:1},{x:1598,duration:.35,ease:"power2.inOut"},"<")
   .set(wipe,{opacity:0})
   .fromTo(T,{strokeDasharray:"2200 2200",strokeDashoffset:2200},{strokeDashoffset:0,duration:1,ease:"power1.inOut"},"<.1")
   .add(heads(iv,0,iv),"<.1")
   .fromTo(L,{strokeDasharray:"1 1",strokeDashoffset:1},{strokeDashoffset:0,duration:.6,ease:"power2.inOut"},"<.3")
   .fromTo(iv.querySelectorAll(".eb,.ivw"),{opacity:0,y:8},{opacity:1,y:0,duration:.35,stagger:.15},"<")
   .add(()=>show(i),"+=.45")
   .to(iv,{clipPath:"inset(0 0 0 100%)",duration:.5,ease:"power2.inOut"})
   .fromTo(wipe,{x:0,opacity:1},{x:1598,duration:.5,ease:"power2.inOut"},"<")
   .to(wipe,{opacity:0,duration:.15});return}
 busy=gsap.timeline({onComplete(){busy=null;gsap.set(ns,{clearProps:"clipPath"});gsap.set(wipe,{opacity:0})}})
  .to(kids,{opacity:0,y:-14,duration:.2,stagger:.015,ease:"power2.in"})
  .add(()=>{gsap.set(kids,{clearProps:"opacity,transform"});gsap.set(ns,{clipPath:a});show(i)})
  .fromTo(ns,{clipPath:a},{clipPath:"inset(0 0% 0 0%)",duration:.6,ease:"power2.inOut"})
  .fromTo(wipe,{x:back?1598:0,opacity:1},{x:back?0:1598,duration:.6,ease:"power2.inOut"},"<")
  .to(wipe,{opacity:0,duration:.15})};go=window.go;
addEventListener("resize",()=>{if(!busy)links(slides[cur])});
tbSet(cur);(document.fonts&&document.fonts.status!=="loaded"?document.fonts.ready:Promise.resolve()).then(()=>enter(cur));
})();
</script>
