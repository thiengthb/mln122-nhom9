  kts:{short:"Cục Thống kê, 2026d",kind:"Thống kê chính thức",url:"https://www.nso.gov.vn/tin-tuc-thong-ke/2026/01/thong-cao-bao-chi-ty-trong-gia-tri-tang-them-cua-kinh-te-so-trong-gdp-grdp-giai-doan-2021-2025/",apa:"Cục Thống kê. (2026d, 5 tháng 1). <i>Thông cáo báo chí tỷ trọng giá trị tăng thêm của kinh tế số trong GDP, GRDP giai đoạn 2021-2025</i>.",use:"Tỷ trọng giá trị tăng thêm của kinh tế số trong GDP năm 2025 ước đạt 14,02%. Đây là giá trị tăng thêm; mục tiêu 30% của Nghị quyết 57 ghi theo quy mô kinh tế số, hai cách đo có thể không đồng nhất."},
  ilo16:{short:"ILO, 2016",kind:"Tổ chức quốc tế",url:"https://www.ilo.org/resource/news/skills-enhancement-vital-viet-nam%E2%80%99s-decent-work-technology-era",apa:"International Labour Organization. (2016, 13 tháng 12). <i>Skills enhancement is vital for Viet Nam's decent work in technology era</i>.",use:"86% lao động dệt, may, da giày có thể đối mặt rủi ro tự động hóa cao (theo khả năng kỹ thuật, mọi loại tự động hóa), trích nghiên cứu ASEAN in transformation. Không phải 86% mất việc."},
  ilo26:{short:"ILO, 2026",kind:"Tổ chức quốc tế",url:"https://www.ilo.org/resource/news/generative-ai-could-transform-millions-jobs-viet-nam-new-ilo-brief-shows",apa:"International Labour Organization. (2026, 16 tháng 4). <i>Generative AI could transform millions of jobs in Viet Nam, new ILO brief shows</i>.",use:"Khoảng 11,5 triệu người làm nghề có tác vụ chịu tác động (phơi nhiễm) của AI tạo sinh; khoảng 1 triệu, dưới 2%, rủi ro tự động hóa cao; nữ 24,1%, nam 17,8%. Khả năng cao hơn là biến đổi nhiệm vụ trong công việc, không phải thay thế hàng loạt."},
  wef25:{short:"WEF, 2025",kind:"Tổ chức quốc tế",url:"https://www.weforum.org/press/2025/01/future-of-jobs-report-2025-78-million-new-job-opportunities-by-2030-but-urgent-upskilling-needed-to-prepare-workforces/",apa:"World Economic Forum. (2025, 8 tháng 1). <i>Future of Jobs Report 2025: 78 million new job opportunities by 2030 but urgent upskilling needed to prepare workforces</i>.",use:"+170 triệu, −92 triệu, tăng thêm 78 triệu; 59/100 lao động cần đào tạo lại hoặc nâng kỹ năng."},
  unctad25:{short:"UNCTAD, 2025",kind:"Tổ chức quốc tế",url:"https://unctad.org/press-material/ais-48-trillion-future-un-trade-and-development-alerts-divides-urges-action",apa:"UN Trade and Development. (2025, 7 tháng 4). <i>AI's $4.8 trillion future: UN Trade and Development alerts on divides, urges action</i>.",use:"100 công ty, chủ yếu ở Mỹ và Trung Quốc, chiếm 40% chi R&D doanh nghiệp toàn cầu."},
  qlnn26:{short:"Nguyễn Thị Ngọc Anh, 2026",kind:"Tạp chí khoa học",url:"https://www.quanlynhanuoc.vn/?p=69421",apa:"Nguyễn Thị Ngọc Anh. (2026, 21 tháng 10). Nghịch lý trong nhận thức rủi ro về tự động hóa và khoảng trống kỹ năng số của lao động ngành dệt may tại Việt Nam. <i>Tạp chí Quản lý nhà nước</i>.",use:"67,1% lao động chưa từng được đào tạo kể từ khi đi làm: khảo sát của đề tài ĐTĐL.XH/15-22, 1.770 lao động dệt may và da giày ở 11 tỉnh, thành, 2023–2024, chọn mẫu thuận tiện và có chủ đích. Không phải tỷ lệ toàn ngành. Số Bangladesh đã đối chiếu với báo cáo gốc BLF (2025)."},
  bnews26:{short:"Hằng Trần, 2026",kind:"Thông tấn xã Việt Nam",url:"https://bnews.vn/huong-di-bat-buoc-de-doanh-nghiep-det-may-duy-tri-don-hang/432293.html",apa:"Hằng Trần. (2026, 11 tháng 8). <i>Hướng đi bắt buộc để doanh nghiệp dệt may duy trì đơn hàng</i>. Bnews/TTXVN.",use:"Ngành dệt may có hơn 3,3 triệu lao động."},
  vna26:{short:"TTXVN, 2026",kind:"Thông tấn xã Việt Nam",url:"https://happyvietnam.vnanet.vn/en/ai-reshapes-logistics-raising-bar-for-workforce-skills/58804.html",apa:"Thông tấn xã Việt Nam. (2026, 12 tháng 6). <i>AI reshapes logistics, raising bar for workforce skills</i>.",use:"Theo Hiệp hội Doanh nghiệp dịch vụ Logistics, ngành cần khoảng 2,2 triệu lao động đến 2030. Đây là tổng nhu cầu, bài báo không nói là số tuyển mới. Số dẫn lại."},
  wbrd:{short:"World Bank, k.n.-a",kind:"Thống kê quốc tế",url:"https://api.worldbank.org/v2/country/VN%3BKR%3BJP/indicator/GB.XPD.RSDV.GD.ZS?date=2023&format=json&per_page=100",apa:"World Bank. (k.n.-a). <i>Research and development expenditure (% of GDP)</i> [Bộ dữ liệu]. World Development Indicators, số của UNESCO Institute for Statistics. Truy cập 04/11/2026.",use:"Năm 2023: Hàn Quốc 4,94% (4,94352); Nhật Bản 3,44% (3,44125); Việt Nam 0,41% (0,41456). Link là API của World Bank cho ba nước, vì trang biểu đồ ghép ba nước bị lỗi."},
  ifr26:{short:"IFR, 2026",kind:"Hiệp hội quốc tế",url:"https://ifr.org/news/robot-density-surges-in-europe-asia-and-americas/1",apa:"International Federation of Robotics. (2026, 8 tháng 4). <i>Robot density surges in Europe, Asia and Americas</i>.",use:"Số liệu 2024 từ World Robotics 2025: Hàn Quốc 1.220, Singapore 818, Nhật Bản 446, Trung Quốc 166."},
  gii26:{short:"WIPO, 2026",kind:"Tổ chức quốc tế",url:"https://www.wipo.int/edocs/gii-ranking/2026/vn.pdf",apa:"World Intellectual Property Organization. (2026). <i>Global Innovation Index 2026: Viet Nam</i> [Hồ sơ quốc gia].",use:"Việt Nam hạng 43/139; trụ cột vốn con người và nghiên cứu (Human capital and research) hạng 79, thấp nhất trong các trụ cột."},
  ea26:{short:"Nguyễn Hoàng Hải và Trần Anh Tuấn, 2026",kind:"Tạp chí khoa học",url:"https://www.quanlynhanuoc.vn/?p=56875",apa:"Nguyễn Hoàng Hải và Trần Anh Tuấn. (2026, 22 tháng 1). Chính sách khoa học, công nghệ, đổi mới sáng tạo trong công nghiệp hóa của một số quốc gia Đông Á và đề xuất định hướng cho Việt Nam. <i>Tạp chí Quản lý nhà nước</i>.",use:"Nhật Bản 1945–1970, Hàn Quốc 1960–1990; R&D/GDP: Hàn Quốc 4,53%, Nhật Bản 3,26% (2018), Việt Nam 0,53% (2019), số theo Trung tâm Thông tin KH&CN quốc gia, 2021."},
  ldn24:{short:"Lê Đức Nguyên, 2024",kind:"Tạp chí khoa học",url:"https://vjol.info.vn/khcn/article/view/106354",apa:"Lê Đức Nguyên. (2024). Phát triển công nghiệp dựa trên khoa học, công nghệ và đổi mới sáng tạo ở Hàn Quốc và bài học cho Việt Nam. <i>Tạp chí Khoa học và Công nghệ Việt Nam - A</i>, (12A), 50.",use:"Khoảng 20 năm sau khi bắt đầu công nghiệp hóa, Hàn Quốc trở thành nền kinh tế công nghiệp mới. (Số 79 USD trong bài không dùng nữa; dùng số World Bank.)"},
  nq14:{short:"Đảng Cộng sản Việt Nam, 2026",kind:"Văn kiện của Đảng",url:"https://daihoidangtoanquoc.vn/nghi-quyet-dai-hoi-dai-bieu-toan-quoc-lan-thu-xiv-cua-dang-post3297.html",apa:"Đảng Cộng sản Việt Nam. (2026). <i>Nghị quyết Đại hội đại biểu toàn quốc lần thứ XIV của Đảng</i>. Toàn văn đăng trên Trang thông tin Đại hội Đảng toàn quốc.",use:"Mục tiêu đến 2030: \"GDP bình quân đầu người đến năm 2030 đạt khoảng 8.500 USD\"; \"tỉ lệ lao động qua đào tạo có bằng cấp, chứng chỉ đạt 35-40%\"."},
  baldwin:{short:"WEF, 2023",kind:"Tổ chức quốc tế, câu dẫn",url:"https://www.weforum.org/media/growth-summit-2023-job-creation-and-reskilling-must-be-central-to-growth-in-the-age-of-uncertainty-advancing-ai-and-the-green-transition",apa:"World Economic Forum. (2023, 3 tháng 5). <i>Growth Summit 2023: Job creation and reskilling must be central to growth in the age of uncertainty, advancing AI and the green transition</i> [Thông cáo báo chí].",use:"Câu của nhà kinh tế Richard Baldwin (Graduate Institute, Geneva) tại Growth Summit 2023, ghi nguyên văn trong thông cáo; dùng mở phần kết, nhóm dịch. Là lời nhắc, không phải luận cứ chính."},
  wbgdp:{short:"World Bank, k.n.-b",kind:"Thống kê quốc tế",url:"https://data.worldbank.org/indicator/NY.GDP.PCAP.CD?locations=KR",apa:"World Bank. (k.n.-b). <i>GDP per capita (current US$): Korea, Rep.</i> [Bộ dữ liệu]. World Development Indicators. Truy cập 04/11/2026.",use:"1960: 159 USD; 1961: 94 USD; 1962: 107 USD; 1963: 147 USD; 1964: 124 USD. Dao động do tỷ giá, nên slide chỉ nói chưa tới 160 USD."},
  blf25:{short:"BLF, 2025",kind:"Báo cáo nghiên cứu",url:"https://blfbd.com/wp-content/uploads/2025/06/Study-Report_RMG_Automation_Impact_2025.pdf",apa:"Bangladesh Labour Foundation. (2025, tháng 2). <i>Study report: Impact of automation on RMG workers</i> [Nghiên cứu do BRAC University thực hiện, Solidaridad Network Asia hỗ trợ].",use:"Khảo sát 429 công nhân ở Dhaka, Gazipur, Narayanganj (8–10/2024). Khảo sát hồi tưởng: công nhân nhớ lại thời máy thủ công (trước khoảng 2018) và so với thời máy tự động; số người mỗi chuyền thấp hơn 30,58%; khâu cắt 48,34%; khâu may 26,57%. Báo cáo tự ghi là thiếu số liệu theo dõi từng nhà máy qua thời gian. Đo theo dây chuyền, không phải mất việc ròng của ngành."},
  wef25b:{short:"WEF, 2025b",kind:"Tổ chức quốc tế",url:"https://www.weforum.org/publications/the-future-of-jobs-report-2025/2-jobs-outlook",apa:"World Economic Forum. (2025b). <i>The Future of Jobs Report 2025: 2. Jobs outlook</i>.",use:"Riêng AI và công nghệ xử lý thông tin: dự kiến tạo 11 triệu việc, thay 9 triệu việc; robot và hệ thống tự hành: giảm ròng 5 triệu."},
  ieee:{short:"IEEE Computer Society, k.n.",kind:"Hiệp hội khoa học",url:"https://history.computer.org/pioneers/pdfs/j/Jacquard.pdf",apa:"IEEE Computer Society. (k.n.). <i>Joseph-Marie Jacquard</i>. Computer Pioneers.",use:"Máy dệt hoàn thành năm 1804, dùng thẻ đục lỗ điều khiển hoa văn; Babbage được cho là lấy ý tưởng thẻ đục lỗ từ đây."}
};

const $=(q,r=document)=>r.querySelector(q), $$=(q,r=document)=>[...r.querySelectorAll(q)];
const slides=$$("section.s");
const ch=(()=>{try{return new BroadcastChannel("mln122-n9")}catch(e){return null}})();
const PRES=location.hash==="#presenter";
const reduce=matchMedia("(prefers-reduced-motion:reduce)").matches;
let cur=0,step=0;
/* Giao diện: phím D để đổi */
const LOOKS=["giay","reu","cham"];
const cv=n=>getComputedStyle(document.documentElement).getPropertyValue(n).trim();
let CC={};function refreshCC(){["--vai","--vai-2","--son","--nghe","--si","--cham","--cham-3"].forEach(k=>CC[k]=cv(k))}
function setLook(l){if(l==="giay")document.documentElement.removeAttribute("data-look");else document.documentElement.setAttribute("data-look",l);try{localStorage.setItem("n9look",l)}catch(e){}refreshCC();if(window.__loomReset)window.__loomReset();if(window.__morphRefresh)window.__morphRefresh()}
setLook((()=>{try{return localStorage.getItem("n9look")||"giay"}catch(e){return"giay"}})());
delete S.XXdh14;

/* Tên người nói theo số thứ tự; thiếu tên thì ghi "Người n" */
function who(n){return (CONFIG.thanhVien&&CONFIG.thanhVien[n-1])||"Người "+n}

/* Bìa */
(()=>{const m=$("#covermeta");const a=[["NHÓM",CONFIG.group],["LỚP · GIẢNG VIÊN",CONFIG.lop+" · "+CONFIG.giangVien],["NHÓM PHẢN BIỆN",CONFIG.phanBien]];
 if(CONFIG.ngay)a.push(["NGÀY",CONFIG.ngay]);if(CONFIG.thanhVien.length)a.push(["THÀNH VIÊN",CONFIG.thanhVien.map((t,k)=>[`${k+1}. ${t}`,(CONFIG.mssv&&CONFIG.mssv[k])||""])]);
 /* thành viên: mỗi người một ô, đúng thứ tự thuyết trình, MSSV in nhỏ bên cạnh */
 a.forEach(([k,v])=>{const b=document.createElement("b");b.textContent=k;const s=document.createElement("span");
  if(Array.isArray(v)){s.className="mem";v.forEach(([t,id])=>{const i=document.createElement("i");i.textContent=t;if(id){const q=document.createElement("small");q.textContent=id;i.append(" ",q)}s.append(i)})}else s.textContent=v;m.append(b,s)});
})();

/* Khung dệt trên bìa */
function loom(){const c=$("#loom"),g=c.getContext("2d"),C=19,cols=40,rows=45;let row=0,run=true,last=0;
 const mot=(x,y)=>{const a=Math.abs((x%14)-7)+Math.abs((y%14)-7);if(a<2)return"--nghe";if(a===4)return"--son";if(a===7)return"--vai";return null};
 function paint(y){const f=(rows-1-y)/rows;
  for(let x=0;x<cols;x++){const px=x*C,py=y*C;g.clearRect(px,py,C,C);const col=mot(x,y);
   if(f<.5){if(col){g.fillStyle=CC[col];g.fillRect(px+1,py+3,C-2,C-6);g.fillRect(px+5,py+1,C-10,C-2)}else{g.fillStyle=CC["--cham-3"];g.globalAlpha=.35;g.fillRect(px+1,py+8,C-2,3);g.globalAlpha=1}}
   else{const on=col||Math.random()<.13;if(on){g.fillStyle=f<.68&&col?CC[col]:CC["--si"];g.globalAlpha=col?1:.5;g.fillRect(px+4,py+4,C-8,C-8);g.globalAlpha=1}}}}
 function tick(t){if(!run)return;if(t-last>(window.N9_LOOM||60)){last=t;if(row<rows){paint(rows-1-row);window.__loomY=rows-1-row;row++}else{window.__loomY=-1;paint(Math.floor(rows*.4*Math.random()))}}requestAnimationFrame(tick)}
 window.__loomReset=()=>{row=0;window.__loomY=null;if(reduce)for(let y=rows-1;y>=0;y--)paint(y)};
 if(reduce){for(let y=rows-1;y>=0;y--)paint(y);return{stop(){},start(){}}}
 requestAnimationFrame(tick);
 return{stop(){run=false},start(){if(!run){run=true;requestAnimationFrame(tick)}}}}
let lm=null;

/* Bốn cuộc cách mạng: tự chạy sau khi vào slide */
const REV=[
 {n:"1",t:"Giữa thế kỷ XVIII – giữa thế kỷ XIX",h:"Máy móc, nước và hơi nước",b:"Bắt đầu ở Anh, từ ngành dệt",x:"tr. 141"},
 {n:"2",t:"Nửa cuối thế kỷ XIX – đầu thế kỷ XX",h:"Điện và dây chuyền sản xuất",b:"Sản xuất hàng loạt",x:"tr. 141–142"},
 {n:"3",t:"Đầu thập niên 1960 – cuối thế kỷ XX",h:"Máy tính và tự động hóa",b:"Bán dẫn, Internet, robot",x:"tr. 142"},
 {n:"4",t:"Được nhắc đến từ năm 2011",h:"Nối thế giới thực với thế giới số",b:"AI, dữ liệu lớn, Internet vạn vật",x:"tr. 142–143"}];
$("#revlist").innerHTML=REV.map((r,i)=>`<div class="rv" data-r="${i}"><b>${r.n}</b><div><h3>${r.h}</h3><p>${r.t}. ${r.b}. <span class="n" data-c="gt" data-l="${r.x}">${r.x}</span></p></div></div>`).join("");
const M=(()=>{const c=$("#morph"),g=c.getContext("2d"),W=c.width,H=c.height,N=1440;
 const weave=[];for(let i=0;i<N;i++){const gx=36,gy=20,col=i%gx,row=Math.floor(i/gx)%gy,cx=(col%12)-5.5,cy=(row%10)-4.5,d=Math.abs(cx)+Math.abs(cy);
  weave.push([60+col*20,48+row*24.4,d<2.2?"--nghe":d<4.2?"--son":d<6.2?"--vai":"--cham-3"])}
 const G4=[[165,246],[410,246],[655,246],[165,476],[410,476],[655,476]],line=[];
 for(let i=0;i<N;i++){const k=i%12;
  if(k<4){const lv=i%2,rail=Math.floor(i/2)%2,t=((i*13)%360)/360;line.push([54+t*712,(lv?416:186)+rail*20,"--nghe"])}
  else if(k<8){const [gx,gy]=G4[i%6],tooth=i%12,ang=tooth*Math.PI/6+.2,rr=(i%2?42:31);line.push([gx+Math.cos(ang)*rr,gy+Math.sin(ang)*rr,"--vai"])}
  else{const lv=i%2,box=Math.floor(i/2)%5,bx=78+box*142,by=lv?356:126,s=i%4,u=((i*17)%29)/28;
   line.push([s===0?bx+u*74:s===1?bx+74:s===2?bx+(1-u)*74:bx,s===0?by:s===1?by+u*56:s===2?by+56:by+(1-u)*56,"--son"])}}
 const chip=[];let ci=0;for(let i=0;i<N;i++){const k=i%12,x0=250,y0=120,w=320,h=320;
  if(k<3){const s=i%4,u=((i*19)%80)/79;chip.push([s===0?x0+u*w:s===1?x0+w:s===2?x0+(1-u)*w:x0,s===0?y0:s===1?y0+u*h:s===2?y0+h:y0+(1-u)*h,"--si"])}
  else if(k<8){const side=i%4,lane=Math.floor(i/4)%12,u=((i*23)%40)/39,p=133+lane*26.8,px=263+lane*26.8;
   if(side===0)chip.push([44+u*206,p,"--si"]);
   else if(side===1)chip.push([570+u*206,p,"--si"]);
   else if(side===2)chip.push([px,20+u*100,"--si"]);
   else chip.push([px,440+u*100,"--si"])}
  else{const idx=(ci++)%144,col=idx%12,row=Math.floor(idx/12),cx=col-5.5,cy=row-5.5;
   chip.push([294.5+col*21,164.5+row*21,Math.abs(cx)<2&&Math.abs(cy)<2?"--nghe":(col+row)%3===0?"--son":"--vai"])}}
 const nodes=[
  [95,110,1],[85,280,0],[105,445,0],
  [215,75,0],[200,195,1],[220,355,0],[205,485,0],
  [345,115,0],[335,265,1],[355,405,0],[330,505,0],
  [475,75,0],[485,205,0],[470,335,1],[490,465,0],
  [610,120,0],[600,265,1],[615,400,0],[595,500,0],
  [730,95,0],[740,235,0],[725,375,1],[735,480,0]
 ];
 const edges=[[0,1],[1,2],[0,3],[0,4],[1,4],[1,5],[2,5],[2,6],[3,4],[3,7],[4,7],[4,8],[5,8],[5,9],[6,9],[6,10],[7,8],[7,11],[7,12],[8,12],[8,13],[9,13],[9,14],[10,14],[11,12],[11,15],[12,15],[12,16],[13,16],[13,17],[14,17],[14,18],[15,16],[15,19],[15,20],[16,20],[16,21],[17,21],[17,22],[18,22],[19,20],[20,21],[21,22]];
 const net=[];for(let i=0;i<N;i++){if(i%3===0){const nd=nodes[i%nodes.length];net.push([nd[0],nd[1],nd[2]?"--nghe":"--son"])}
  else{const [u,v]=edges[i%edges.length],A=nodes[u],B=nodes[v],t=.12+((i*31)%35)/44;net.push([A[0]+(B[0]-A[0])*t,A[1]+(B[1]-A[1])*t,i%7===0?"--si":"--vai-2"])}}
 const T=[weave,line,chip,net];let st=0,t0=0,run=false,raf=0,lastP=1,lastFrom=0,lastTo=0,lastTm=0;const STAGE=window.N9_STAGE||13500,MOVE=1800;
 const ease=x=>x<.5?2*x*x:1-Math.pow(-2*x+2,2)/2;
 function hl(i){$$("#revlist .rv").forEach((e,j)=>{e.classList.toggle("on",j===i);e.classList.toggle("done",j<i)})}
 function bg(ctx,stg,al,tm){if(al<=.01)return;ctx.save();ctx.lineCap="round";ctx.lineJoin="round";
  if(stg===0){
   ctx.strokeStyle=CC["--cham-3"];ctx.lineWidth=1.4;ctx.globalAlpha=al*.75;
   for(let col=0;col<36;col++){const x=60+col*20;ctx.beginPath();ctx.moveTo(x,28);ctx.lineTo(x,532);ctx.stroke()}
   for(let row=0;row<20;row++){const y=48+row*24.4;ctx.beginPath();ctx.moveTo(42,y);ctx.lineTo(778,y);ctx.stroke()}
   ctx.strokeStyle=CC["--vai"];ctx.lineWidth=4;ctx.globalAlpha=al*.9;
   ctx.beginPath();ctx.moveTo(38,28);ctx.lineTo(782,28);ctx.moveTo(38,532);ctx.lineTo(782,532);ctx.stroke();
  }else if(stg===1){
   const sh=(tm*.04)%142;
   [186,416].forEach(by=>{
    ctx.strokeStyle=CC["--nghe"];ctx.lineWidth=3.2;ctx.globalAlpha=al*.95;
    ctx.beginPath();ctx.roundRect(44,by,732,20,10);ctx.stroke();
    ctx.lineWidth=1.8;ctx.globalAlpha=al*.55;
    for(let x=64;x<760;x+=28){ctx.beginPath();ctx.moveTo(x,by+4);ctx.lineTo(x,by+16);ctx.stroke()}
    for(let b=0;b<5;b++){const bx=58+((b*142+sh)%710);if(bx>700)continue;const y=by-60;
     ctx.globalAlpha=al*.18;ctx.fillStyle=CC["--son"];ctx.fillRect(bx,y,74,56);
     ctx.globalAlpha=al*.95;ctx.strokeStyle=CC["--son"];ctx.lineWidth=2.6;ctx.strokeRect(bx,y,74,56);
     ctx.beginPath();ctx.moveTo(bx,y+18);ctx.lineTo(bx+74,y+18);ctx.moveTo(bx+26,y);ctx.lineTo(bx+26,y+18);ctx.moveTo(bx+48,y);ctx.lineTo(bx+48,y+18);ctx.stroke()}});
   G4.forEach(([gx,gy],k)=>{const rot=tm*.0012*(k%2?-1:1);
    ctx.save();ctx.translate(gx,gy);ctx.rotate(rot);ctx.strokeStyle=CC["--vai"];ctx.fillStyle=CC["--vai"];ctx.globalAlpha=al*.9;ctx.lineWidth=2.4;
    ctx.beginPath();for(let t=0;t<12;t++){const a0=t*Math.PI/6,a1=a0+.11,a2=a0+.26,a3=a0+.37;
     const p0=[Math.cos(a0)*31,Math.sin(a0)*31],p1=[Math.cos(a1)*42,Math.sin(a1)*42],p2=[Math.cos(a2)*42,Math.sin(a2)*42],p3=[Math.cos(a3)*31,Math.sin(a3)*31];
     t?ctx.lineTo(p0[0],p0[1]):ctx.moveTo(p0[0],p0[1]);ctx.lineTo(p1[0],p1[1]);ctx.lineTo(p2[0],p2[1]);ctx.lineTo(p3[0],p3[1])}
    ctx.closePath();ctx.stroke();
    ctx.beginPath();ctx.arc(0,0,13,0,6.283);ctx.stroke();
    for(let s=0;s<4;s++){const a=s*Math.PI/2;ctx.beginPath();ctx.moveTo(Math.cos(a)*13,Math.sin(a)*13);ctx.lineTo(Math.cos(a)*30,Math.sin(a)*30);ctx.stroke()}
    ctx.restore()});
  }else if(stg===2){
   ctx.strokeStyle=CC["--si"];ctx.fillStyle=CC["--si"];ctx.globalAlpha=al*.85;ctx.lineWidth=2.2;
   for(let lane=0;lane<12;lane++){const y=133+lane*26.8,x=263+lane*26.8;
    ctx.beginPath();ctx.moveTo(44,y);ctx.lineTo(250,y);ctx.moveTo(570,y);ctx.lineTo(776,y);
    ctx.moveTo(x,20);ctx.lineTo(x,120);ctx.moveTo(x,440);ctx.lineTo(x,540);ctx.stroke();
    [[44,y],[776,y],[x,20],[x,540]].forEach(([cx,cy])=>{ctx.beginPath();ctx.arc(cx,cy,4,0,6.283);ctx.fill()})}
   ctx.globalAlpha=al*.95;ctx.strokeStyle=CC["--si"];ctx.lineWidth=3.6;ctx.strokeRect(250,120,320,320);
   ctx.strokeStyle=CC["--vai"];ctx.lineWidth=2.2;ctx.strokeRect(276,146,268,268);
   ctx.strokeStyle=CC["--nghe"];ctx.lineWidth=2.4;ctx.strokeRect(368,238,84,84);
   ctx.beginPath();ctx.arc(264,134,4.5,0,6.283);ctx.fillStyle=CC["--nghe"];ctx.fill();
  }else if(stg===3){
   ctx.lineWidth=1.8;
   edges.forEach(([u,v],k)=>{const A=nodes[u],B=nodes[v];ctx.strokeStyle=CC[k%5===0?"--si":"--vai-2"];ctx.globalAlpha=al*(k%5===0?.75:.42);
    ctx.beginPath();ctx.moveTo(A[0],A[1]);ctx.lineTo(B[0],B[1]);ctx.stroke()});
  }
  ctx.restore()}
 function fg(ctx,stg,al,tm){if(al<=.01)return;ctx.save();
  if(stg===0){
   const sy=48+9*24.4,sx=410+Math.sin(tm*.0025)*260;
   ctx.globalAlpha=al*.95;ctx.strokeStyle=CC["--nghe"];ctx.lineWidth=2.5;ctx.beginPath();ctx.moveTo(42,sy);ctx.lineTo(778,sy);ctx.stroke();
   ctx.fillStyle=CC["--nghe"];ctx.strokeStyle=CC["--vai"];ctx.lineWidth=2;
   ctx.beginPath();ctx.moveTo(sx-34,sy);ctx.quadraticCurveTo(sx,sy-12,sx+34,sy);ctx.quadraticCurveTo(sx,sy+12,sx-34,sy);ctx.fill();ctx.stroke();
  }else if(stg===3){
   edges.forEach(([u,v],k)=>{const A=nodes[u],B=nodes[v],f=((tm*.00045+k*.17)%1),px=A[0]+(B[0]-A[0])*f,py=A[1]+(B[1]-A[1])*f;
    ctx.fillStyle=CC[k%3===0?"--nghe":"--son"];ctx.globalAlpha=al*.9;ctx.beginPath();ctx.arc(px,py,3.4,0,6.283);ctx.fill()});
   nodes.forEach(([nx,ny,hub])=>{const r=hub?12:8;
    ctx.fillStyle=CC["--cham"];ctx.globalAlpha=al;ctx.beginPath();ctx.arc(nx,ny,r,0,6.283);ctx.fill();
    ctx.strokeStyle=CC[hub?"--nghe":"--son"];ctx.lineWidth=hub?3:2.2;ctx.beginPath();ctx.arc(nx,ny,r,0,6.283);ctx.stroke();
    ctx.fillStyle=CC[hub?"--nghe":"--son"];ctx.beginPath();ctx.arc(nx,ny,hub?5:3.5,0,6.283);ctx.fill()});
  }
  ctx.restore()}
 function drawTo(ctx,from,to,p,tm){ctx.clearRect(0,0,W,H);const e=ease(p);
  if(from!==to&&e<.98)bg(ctx,from,1-e,tm);
  bg(ctx,to,from===to?1:e,tm);
  for(let i=0;i<N;i++){const a=T[from][i],b=T[to][i],col=p<.5?a[2]:b[2],stNow=p<.5?from:to;
   if(from===to&&stNow===1&&i%12>=4)continue;
   if(from===to&&stNow===3&&i%3===0)continue;
   let x=a[0]+(b[0]-a[0])*e,y=a[1]+(b[1]-a[1])*e;
   ctx.fillStyle=CC[col];
   if(stNow===0){const w=col==="--cham-3"?4:11,h=col==="--cham-3"?4:7;ctx.globalAlpha=col==="--cham-3"?.45:.92;ctx.fillRect(x-w/2,y-h/2,w,h)}
   else if(stNow===2&&i%12>=8){ctx.globalAlpha=.92;ctx.fillRect(x-5,y-5,10,10)}
   else{const s=stNow===1?4:3.4;ctx.globalAlpha=.85;ctx.fillRect(x-s/2,y-s/2,s,s)}}
  if(from!==to&&e<.98)fg(ctx,from,1-e,tm);
  fg(ctx,to,from===to?1:e,tm);
  ctx.globalAlpha=1}
 function frame(tm){if(!run)return;const el=Math.max(0,tm-t0);const i=Math.min(3,Math.floor(el/STAGE));if(i!==st){st=i;hl(i)}
  const into=el-i*STAGE;const p=i===0?1:Math.min(1,into/MOVE);lastFrom=i===0?0:i-1;lastTo=i;lastP=p;lastTm=tm;drawTo(g,lastFrom,lastTo,p,tm);raf=requestAnimationFrame(frame)}
 return{start(){if(reduce){lastFrom=3;lastTo=3;lastP=1;lastTm=2200;drawTo(g,3,3,1,2200);hl(3);return}run=true;st=0;hl(0);t0=performance.now();lastFrom=0;lastTo=0;lastP=1;lastTm=0;drawTo(g,0,0,1,0);cancelAnimationFrame(raf);raf=requestAnimationFrame(frame)},
  stop(){run=false;cancelAnimationFrame(raf)},
  redraw(){drawTo(g,lastFrom,lastTo,lastP,lastTm)},
  snap(j,canv){const cv2=canv||document.createElement("canvas");cv2.width=W;cv2.height=H;drawTo(cv2.getContext("2d"),j,j,1,2200);return cv2}}})();
window.__morphSnap=M.snap;

/* Lưới 100 ô */
const WC={s:"var(--son)",y:"var(--nghe)",w:"var(--vai)",g:"var(--cham-3)",m:"var(--si)",o:"var(--ghost)"};
$$("[data-wf]").forEach(w=>{const parts=w.dataset.wf.split(",").map(x=>x.split(":"));let cells=[],acc=0,done=0;parts.forEach(([v,c],i)=>{acc+=+v;const to=i===parts.length-1?100:Math.round(acc);for(;done<to;done++)cells.push(c)});
 w.innerHTML=cells.map((c,i)=>`<i style="background:${WC[c]};--d:${i}"></i>`).join("")});

/* Mô phỏng */
function sim(a,all){const N=100*(1-.6*a),c=100+40*a,v=N,m=N,unit=(c+2*N)/100,social=all?unit:3,x=(social-unit)*100;return{N,c,v,m,unit,social,x,r:c/v}}
$("#dots").innerHTML="<i></i>".repeat(100);
const fmt=(x,d=1)=>x.toFixed(d).replace(".",",");
function runSim(){const a=+$("#simA").value/100,all=$("#simAll").getAttribute("aria-pressed")==="true",o=sim(a,all);
 $("#simAv").textContent=Math.round(a*100)+"%";$("#simN").textContent=Math.round(o.N);
 $$("#dots i").forEach((d,i)=>d.classList.toggle("out",i>=Math.round(o.N)));
 $("#simC").textContent=fmt(o.c,0);$("#simV").textContent=fmt(o.v,0);$("#simR").textContent=fmt(o.r,2);
 $("#simU").textContent=fmt(o.unit,2);$("#simS").textContent=fmt(o.social,2);$("#simX").textContent=fmt(o.x,0);
 $("#simAll").textContent=all?"Cả ngành đã dùng máy như vậy":"Một xưởng dùng máy trước các xưởng khác";
 $("#simText").textContent=all?"Giá chung của thị trường hạ xuống, phần siêu ngạch mất, ai cũng phải đổi mới tiếp. Mô hình chỉ xét một dây chuyền, sản lượng không đổi; không dự báo việc làm cả ngành.":"Xưởng này làm ra sản phẩm rẻ hơn nhưng vẫn bán theo giá chung: phần chênh là giá trị thặng dư siêu ngạch (tr. 65). c/v tăng (tr. 68).";}
$("#simA").addEventListener("input",()=>{simRun=false;runSim()});
let simRun=false;function simPlay(){$("#simAll").setAttribute("aria-pressed","false");if(reduce){$("#simA").value=100;runSim();return}$("#simA").value=0;runSim();simRun=true;const t0=performance.now();(function f(t){if(!simRun)return;const p=Math.min(1,(t-t0)/9000);$("#simA").value=Math.round(p*100);runSim();if(p<1)requestAnimationFrame(f)})(t0)}
runSim();

/* Thẻ chỉ tiêu */
const G=[["Kinh tế số","% GDP",14.02,30,"14,02%","năm 2025","≥ 30%","Nghị quyết 57","kts","nq57","--son","giá trị tăng thêm; Nghị quyết ghi quy mô, có thể khác cách đo"],["Chi cho nghiên cứu","% GDP",.41,2,"0,41%","năm 2023","2%","Nghị quyết 57","wbrd","nq57","--nghe",""],["Lao động có bằng cấp, chứng chỉ","% lao động",30.4,35,"30,4%","quý III/2026","35–40%","Đại hội XIV","nso26ld","nq14","--si","bằng cấp chưa phải là năng lực"],["GDP bình quân đầu người","USD",5026,8500,"5.026","năm 2025","khoảng 8.500","Đại hội XIV","nso25","nq14","--vai",""]];
/* Thẻ "mức hiện tại → mốc 2030": không vẽ vòng tiến độ vì bốn chỉ tiêu khác đơn vị và cách đo. */
$("#gauges").innerHTML=G.map(g=>`<div class="panel gc"><h3 style="font-size:25px;min-height:58px">${g[0]}</h3><span class="big n" data-c="${g[8]}" style="color:var(${g[10]})">${g[4]}</span><p class="sm" style="font-size:18px">${g[5]} · đơn vị: ${g[1]}</p><p style="font-size:24px">Mốc 2030: <b class="n" data-c="${g[9]}">${g[6]}</b></p><p class="sm" style="font-size:18px">Mốc theo ${g[7]}.${g[11]?" "+g[11][0].toUpperCase()+g[11].slice(1)+".":""}</p></div>`).join("");

/* Kế hoạch 90 ngày */
const P={"Kỹ thuật phần mềm":[["viết code mẫu, sinh test, giải thích đoạn code lạ"],["thiết kế hệ thống, đánh giá bảo mật, chịu trách nhiệm khi có lỗi"],["30: tự đọc và sửa được code do AI viết","60: làm một dự án có kiểm thử đầy đủ","90: viết tài liệu thiết kế, xin góp ý từ người đi trước"]],
"Trí tuệ nhân tạo":[["làm sạch dữ liệu thô, thử nhanh mô hình"],["xác định đúng vấn đề, đánh giá sai lệch, hiểu dữ liệu nói được gì và không nói được gì"],["30: học chắc xác suất, thống kê","60: làm một mô hình với dữ liệu Việt Nam","90: công bố báo cáo đánh giá, kể cả chỗ mô hình sai"]],
"An toàn thông tin":[["đọc log, tóm tắt cảnh báo"],["điều tra sự cố, đánh giá rủi ro, tuân thủ pháp luật"],["30: học nền tảng mạng, hệ điều hành","60: luyện trên môi trường thực hành hợp pháp","90: viết báo cáo đánh giá một hệ thống của mình"]],
"Thiết kế":[["phác nhanh nhiều phương án"],["ý tưởng, thẩm mỹ, bản quyền hình ảnh"],["30: học nguyên lý bố cục, chữ, màu","60: làm bộ nhận diện cho một dự án thật","90: ghi rõ phần AI, phần tự làm trong hồ sơ"]],
"Kinh doanh, Marketing":[["tổng hợp thị trường, viết nháp nội dung"],["hiểu khách hàng, kiểm tra số liệu, quyết định có đạo đức"],["30: học đọc số liệu thống kê","60: khảo sát thật 30 khách hàng","90: viết đề xuất có nguồn số liệu rõ ràng"]],
"Logistics":[["soạn nháp chứng từ, dự báo nhu cầu"],["xử lý sự cố chuỗi cung ứng, hiểu luật thương mại, đàm phán"],["30: nắm các quy tắc cơ bản về thương mại quốc tế","60: học một hệ thống quản lý kho hoặc vận tải","90: làm phương án tối ưu cho tình huống thật"]],
"Ngôn ngữ":[["dịch nháp, tra thuật ngữ, luyện hội thoại"],["hiểu văn hóa, sắc thái, chịu trách nhiệm về bản dịch"],["30: học một lĩnh vực chuyên ngành","60: tự sửa 20 trang bản dịch máy, ghi lại các lỗi","90: làm cộng tác viên cho một dự án thật"]]};
let major=Object.keys(P)[0];
function plan(){$$("#majors button").forEach(b=>b.setAttribute("aria-pressed",b.dataset.m===major));const p=P[major];
 $("#plan").innerHTML=`<div class="panel"><span class="eb">GIAO CHO AI, RỒI KIỂM TRA LẠI</span><p>${p[0][0]}</p></div><div class="panel"><span class="eb">TỰ MÌNH GIỮ</span><p>${p[1][0]}</p></div><div class="panel dark"><span class="eb">30 · 60 · 90 NGÀY</span>${p[2].map(x=>{const[d,...r]=x.split(": ");return`<p><b>Ngày ${d}:</b> ${r.join(": ")}</p>`}).join("")}</div>`}
$("#majors").innerHTML=Object.keys(P).map(m=>`<button data-m="${m}">${m}</button>`).join("");
$("#majors").addEventListener("click",e=>{const b=e.target.closest("[data-m]");if(b){major=b.dataset.m;plan();b.blur()}});plan();

/* Tài liệu tham khảo */
$("#refs").innerHTML=Object.values(S).slice().sort((a,b)=>a.apa.replace(/<[^>]+>/g,"").localeCompare(b.apa.replace(/<[^>]+>/g,""),"vi")).map(s=>`<p>${s.apa} <a href="${s.url}" target="_blank" rel="noopener">${s.url.replace(/^https?:\/\/(www\.)?/,"").split("/")[0]}</a></p>`).join("");

/* Số liệu bấm được bằng bàn phím */
$$(".n").forEach(n=>{n.setAttribute("role","button")});
/* Chân slide: nguồn */
slides.forEach(s=>{const r=s.dataset.refs;if(!r)return;const f=document.createElement("div");f.className="foot";f.innerHTML="<span>Nguồn:</span>"+r.split(";").map(x=>{const[k,l]=x.split("|");return`<button tabindex="-1" data-c="${k}" ${l?`data-l="${l}"`:""}>${S[k].short}${l?", "+l:""}</button>`}).join("<span>;</span>");s.append(f)});

/* Ngăn nguồn */
const dr=$("#drawer");
function cite(k,l){const s=S[k];if(!s)return;dr.innerHTML=`<button class="x" id="drx">Đóng · Esc</button><span class="tag ${/Thống kê|Giáo trình|Văn kiện|kinh điển/.test(s.kind)?"m":"y"}" style="width:fit-content">${s.kind}</span><h3>${s.short}${l?", "+l:""}</h3><p>${s.use}</p><p class="sm">${s.apa}</p><a href="${s.url}" target="_blank" rel="noopener">${s.url}</a>`;dr.classList.add("on");$("#drx").onclick=()=>dr.classList.remove("on")}
document.addEventListener("click",e=>{const n=e.target.closest("[data-c]");if(n){e.stopPropagation();cite(n.dataset.c,n.dataset.l)}});

/* Sợi chỉ: chia theo 5 người */
const ACTS=["Người 1","Người 2","Người 3","Người 4","Người 5"];
function threadSvg(){const w=1600,firsts=ACTS.map((_,a)=>slides.findIndex(s=>+s.dataset.who===a+1));const xOf=i=>30+(w-60)*i/(slides.length-1);
 let d=`M30 16`;for(let x=30;x<w-30;x+=26){d+=` Q${x+13} ${x%52===30?7:25} ${x+26} 16`}
 $("#thread").innerHTML=`<svg viewBox="0 0 1600 40" preserveAspectRatio="none"><path d="${d}" fill="none" style="stroke:var(--cham-3)" stroke-width="2.5" stroke-dasharray="7 6"/><path id="tp" d="${d}" fill="none" stroke-width="3.5" pathLength="100" stroke-dasharray="0 100" style="stroke:var(--son);transition:stroke-dasharray .6s"/>
 ${firsts.map(f=>`<circle cx="${xOf(f)}" cy="16" r="7" style="fill:var(--nghe)"/>`).join("")}</svg>`}
threadSvg();

/* Điều hướng: một phím cho một nhịp */
const warp=$("#warp");warp.innerHTML=Array.from({length:40},(_,j)=>`<i style="--j:${j}"></i>`).join("");
function applyStep(){const s=slides[cur];$$("[data-s]",s).forEach(e=>e.classList.toggle("in",+e.dataset.s<=step));
 if(s.dataset.title==="Mô phỏng c/v"){const on=step>=1;simRun=simRun&&!on;if(on){$("#simA").value=100}$("#simAll").setAttribute("aria-pressed",on);runSim()}}
function show(i,st=0){slides.forEach((s,j)=>s.classList.toggle("on",j===i));cur=i;step=st;$("#pg").textContent=(i+1)+" / "+slides.length;const p=slides.length>1?i/(slides.length-1)*100:0;$("#tp").setAttribute("stroke-dasharray",`${p} ${100-p}`);
 try{history.replaceState(null,"","#"+(i+1))}catch(e){}
 $("#notes").innerHTML=$(".notes",slides[i])?.innerHTML||"";dr.classList.remove("on");
 const t=slides[i].dataset.title;
 if(i===0){lm=lm||loom();lm.start()}else if(lm)lm.stop();
 if(t==="Bốn cuộc cách mạng")M.start();else M.stop();
 if(t==="Mô phỏng c/v"&&st===0)simPlay();else simRun=false;
 applyStep();if(ch)ch.postMessage({t:"at",i})}
function go(i){i=Math.max(0,Math.min(slides.length-1,i));if(i===cur)return;
 if(reduce){show(i);return}warp.classList.remove("go");void warp.offsetWidth;warp.classList.add("go");setTimeout(()=>show(i),270)}
function next(){const n=+slides[cur].dataset.steps||0;if(step<n){step++;applyStep()}else go(cur+1)}
function prev(){if(step>0){step--;applyStep()}else go(cur-1)}
addEventListener("keydown",e=>{if(/INPUT|TEXTAREA/.test(e.target.tagName)&&e.target.type!=="range")return;const k=e.key;
 if(k==="ArrowRight"||k==="PageDown"||k===" "||k==="Enter"||k==="ArrowDown"){e.preventDefault();e.target.blur?.();next()}
 else if(k==="ArrowLeft"||k==="PageUp"||k==="ArrowUp"){e.preventDefault();prev()}
 else if(k==="Home")go(0);else if(k==="End")go(slides.length-1);
 else if(k==="n"||k==="N")$("#notes").classList.toggle("on");
 else if(k==="k"||k==="K")document.body.classList.toggle("k");
 else if(k==="f"||k==="F"){document.fullscreenElement?document.exitFullscreen():document.documentElement.requestFullscreen?.().catch(()=>{})}
 else if(k==="t"||k==="T")startClock();
 else if(k==="d"||k==="D"){const c=document.documentElement.getAttribute("data-look")||"giay";setLook(LOOKS[(LOOKS.indexOf(c)+1)%3])}
 else if(k==="p"||k==="P")window.open(location.pathname+"#presenter","n9p");
 else if(k==="Escape")dr.classList.remove("on")});

/* Co sân khấu vừa màn hình */
function fit(){const st=$("#stage"),z=Math.min(innerWidth/1600,innerHeight/900);st.style.transform=`scale(${z}) translate(-50%,-50%)`}
addEventListener("resize",fit);fit();

/* Đồng hồ */
let t0=null;function startClock(){t0=Date.now();if(ch)ch.postMessage({t:"clock",t0})}
function fmtT(){if(!t0)return"00:00";const s=Math.floor((Date.now()-t0)/1000);return String(Math.floor(s/60)).padStart(2,"0")+":"+String(s%60).padStart(2,"0")}
if(PRES)setInterval(()=>{$("#pvc").textContent=fmtT()},1000);

/* Cửa sổ người nói */
if(PRES){document.body.classList.add("pres");const paint=i=>{cur=i;const s=slides[i];$("#pvt").textContent=`Slide ${i+1}/${slides.length} · ${who(s.dataset.who)} · ${s.dataset.title}`;$("#pvn").innerHTML=$(".notes",s)?.innerHTML||"";$("#pvm").textContent=`Dự kiến ${s.dataset.min||0} phút. Slide sau: ${slides[i+1]?.dataset.title||"hết"}.`};
 ch&&(ch.onmessage=e=>{if(e.data.t==="at")paint(e.data.i);if(e.data.t==="clock")t0=e.data.t0});paint(0);
 $("#pvp").onclick=()=>ch&&ch.postMessage({t:"prev"});$("#pvx").onclick=()=>ch&&ch.postMessage({t:"next"});$("#pvr").onclick=startClock}
else{ch&&(ch.onmessage=e=>{if(e.data.t==="next")next();if(e.data.t==="prev")prev();if(e.data.t==="clock")t0=e.data.t0});
 const h=parseInt(location.hash.slice(1),10);cur=-1;show(h>=1&&h<=slides.length?h-1:0)}
window.__sim=sim;
</script>
