<!-- Bản thử hướng A "Sợi chỉ xuyên suốt". Chạy sau app.part và GSAP (vendor/gsap).
     Không sửa app.part: chỉ bọc lại go() và show() để thêm sợi chỉ và chuyển cảnh. -->
<style>
#yarn{position:absolute;inset:0;width:1600px;height:900px;pointer-events:none;z-index:4;overflow:visible}
#yarn path{fill:none;stroke:var(--son);stroke-width:5;stroke-linecap:round;stroke-linejoin:round}
#yarn path.br{stroke:var(--si);stroke-width:3.5}
#yarn .nd{fill:var(--cham);stroke:var(--son);stroke-width:4}
#yarn .nd.on{fill:var(--nghe);stroke:var(--nghe)}
#yarn #yhead{fill:var(--nghe);stroke:var(--cham);stroke-width:3}
.s.on h1.r,.s.on h2.r{animation:none}
.sw{display:inline-block}
#cvw{margin-top:4px}
#cvw svg{display:block;width:100%;height:auto;overflow:visible}
#cvw .ax{stroke:var(--cham-3);stroke-width:2}
#cvw .cv{fill:none;stroke:var(--son);stroke-width:5;stroke-linecap:round}
#cvw .cvg{fill:none;stroke:var(--cham-3);stroke-width:2;stroke-dasharray:4 6}
#cvw text{fill:var(--vai-2);font:600 15px var(--mono)}
#cvw .hd{fill:var(--nghe);stroke:var(--cham-2);stroke-width:3}
#warp{display:none}
</style>
<script>
(()=>{
if(PRES||!window.gsap)return;
gsap.registerPlugin(DrawSVGPlugin,SplitText);
const NS="http://www.w3.org/2000/svg",stage=$("#stage");
const svg=document.createElementNS(NS,"svg");svg.id="yarn";svg.setAttribute("viewBox","0 0 1600 900");svg.setAttribute("aria-hidden","true");
stage.insertBefore(svg,$("#thread"));
const mk=(tag,at)=>{const e=document.createElementNS(NS,tag);for(const k in at)e.setAttribute(k,at[k]);svg.append(e);return e};

/* Toạ độ trên sân khấu 1600x900 */
const z=()=>stage.getBoundingClientRect().width/1600;
function box(el){let x=0,y=0,e=el;while(e&&e!==stage){x+=e.offsetLeft;y+=e.offsetTop;e=e.offsetParent}return{x,y,w:el.offsetWidth,h:el.offsetHeight}}
function rects(el){const S=stage.getBoundingClientRect(),k=z();return[...el.getClientRects()].map(r=>({x:(r.left-S.left)/k,y:(r.top-S.top)/k,w:r.width/k,h:r.height/k}))}

/* Mẫu nét: gợn sóng như sợi vải, nút thắt, bậc vuông như mạch điện */
const wave=(x1,x2,y,a=5,p=34)=>{let d="",up=1;for(let x=x1;x<x2;x+=p){const nx=Math.min(x+p,x2);d+=` Q${(x+nx)/2} ${y+a*up} ${nx} ${y}`;up=-up}return d};
const knot=(x,y)=>` C${x+34} ${y} ${x+40} ${y-34} ${x+20} ${y-34} C${x} ${y-34} ${x+4} ${y+2} ${x+46} ${y+4}`;
const steps=(x,y1,y2,w=18,n=4)=>{let d="",h=(y2-y1)/n;for(let i=0;i<n;i++){const y=y1+h*i;d+=` L${x+w} ${y} L${x+w} ${y+h/2} L${x} ${y+h/2} L${x} ${y+h}`}return d};

/* Gạch dưới cụm chữ nhấn (em) của tiêu đề, đi vào từ mép trái */
function underline(s){if(s.__u)return s.__u;const h=$("h1,h2",s);if(!h)return null;const em=$$("em",h).pop();
 const r=(em?rects(em):rects(h)).filter(q=>q.w>8).pop();if(!r)return null;
 const y=r.y+r.h+2,x1=r.x,x2=r.x+r.w;
 return s.__u={y,x1,x2,end:[x2+46,y+4],tail:wave(x1,x2,y)+knot(x2,y),d:`M-20 ${y} L${x1} ${y}`+wave(x1,x2,y)+knot(x2,y)}}

/* Mỗi slide: các đoạn sợi chỉ; "at" là nhịp mà đoạn đó được vẽ (0 = lúc vào slide) */
function plan(s){const u=underline(s);if(!u)return[];const t=s.dataset.title;let [ex,ey]=u.end;
 if(t==="Bìa"){const L=box($("#loom"));const by=L.y+L.h-14,dx=L.x+6;let d=u.d+` C${ex+60} ${ey} ${dx} ${ey-20} ${dx} ${ey+60} L${dx} ${by-40} Q${dx} ${by} ${dx+40} ${by}`;
  let x=dx+40;for(let i=0;x<1620;i++){const nx=x+38;d+=` Q${x+19} ${by+(i%2?9:-9)} ${nx} ${by}`;x=nx}return[{d,at:0,dur:2.8}]}
 if(t==="Bốn cuộc cách mạng"){const rv=$$("#revlist .rv",s).map(box);const X=40,ny=rv.map(b=>b.y+b.h/2);
  const uy=u.y;const segs=[{d:`M-20 ${uy} L${X-16} ${uy} Q${X} ${uy} ${X} ${uy+16} L${X} ${ny[0]}`,at:0,dur:1.2},
   {d:`M${X} ${uy} L${u.x1} ${uy}`+u.tail,at:0,dur:1.4,br:2,delay:.5},
   {d:`M${X} ${ny[0]} L${X} ${ny[1]}`,at:1,dur:1.2},
   {d:`M${X} ${ny[1]}`+steps(X,ny[1],ny[2]),at:2,dur:1.4},
   {d:`M${X} ${ny[2]}`+(()=>{let d="",up=1;for(let y=ny[2];y<ny[3];y+=24){const n=Math.min(y+24,ny[3]);d+=` Q${X+10*up} ${(y+n)/2} ${X} ${n}`;up=-up}return d})(),at:3,dur:1.4}];
  const c=box($("#morph",s)),last=rv[3],by=last.y+last.h+18;
  [[.25,.3],[.55,.65],[.85,.4]].forEach(([fx,fy],k)=>segs.push({d:`M${X} ${ny[3]} L${X} ${by} L${c.x-20} ${by} C${c.x+40} ${by} ${c.x+c.w*fx-80} ${c.y+c.h*fy} ${c.x+c.w*fx} ${c.y+c.h*fy}`,at:3,dur:1.6,br:1,delay:1+k*.25}));
  return{segs,nodes:ny.map(y=>[X,y])}}
 return[{d:u.d+` C${ex+140} ${ey} ${1500} ${ey+6} 1620 ${ey+6}`,at:0,dur:1.6}]}

let segs=[],nodes=[],stageNow=0,head=null,live=[];
function build(s){svg.innerHTML="";const p=plan(s);const sg=Array.isArray(p)?p:p.segs;
 segs=sg.map(q=>{const e=mk("path",{d:q.d});if(q.br===1)e.classList.add("br");gsap.set(e,{drawSVG:"0% 0%"});return{...q,e,done:false}});
 nodes=(p.nodes||[]).map(([x,y])=>{const c=mk("circle",{cx:x,cy:y,r:10,class:"nd"});gsap.set(c,{scale:0,transformOrigin:"50% 50%"});return c});
 head=mk("circle",{r:8,id:"yhead"});gsap.set(head,{opacity:0});stageNow=0}
function drawTo(n,instant){segs.forEach(q=>{if(q.done||q.at>n)return;q.done=true;
  if(instant||reduce){gsap.set(q.e,{drawSVG:"0% 100%"});return}
  const L=q.e.getTotalLength(),o={p:0};
  live.push(gsap.to(o,{p:1,duration:q.dur,delay:q.delay||0,ease:"power2.inOut",onStart(){if(!q.br)gsap.set(head,{opacity:1})},onUpdate(){gsap.set(q.e,{drawSVG:`0 ${o.p*L}`});if(!q.br){const pt=q.e.getPointAtLength(o.p*L);head.setAttribute("cx",pt.x);head.setAttribute("cy",pt.y)}},
   onComplete(){if(!q.br){const pt=q.e.getPointAtLength(L);if(pt.x>1590)gsap.to(head,{opacity:0,duration:.2})}}}))});
 nodes.forEach((c,i)=>{if(i<=n){const was=c._in;c._in=1;c.classList.toggle("on",i===n);if(!was)live.push(gsap.to(c,{scale:1,duration:.4,delay:instant||reduce?0:(i===0?1.7:1.1),ease:"back.out(3)"}))}})}

/* Tiêu đề hiện ra theo từng chữ */
function title(s){const h=$("h1,h2",s);if(!h||reduce)return;h.__sp=h.__sp||SplitText.create(h,{type:"words",mask:"words",wordsClass:"sw"});
 live.push(gsap.fromTo(h.__sp.words,{yPercent:110},{yPercent:0,duration:.7,ease:"power3.out",stagger:.045,delay:.05}))}

function enter(i){live.forEach(t=>t.kill());live=[];const s=slides[i];build(s);title(s);
 let n=0;if(s.dataset.title==="Bốn cuộc cách mạng"){const on=$$("#revlist .rv",s).findIndex(e=>e.classList.contains("on"));n=Math.max(0,on)}
 drawTo(n)}

/* Đồng bộ với hình bốn cuộc cách mạng: khi mục sáng lên thì sợi chỉ chạy tới đó */
new MutationObserver(()=>{if(slides[cur]?.dataset.title!=="Bốn cuộc cách mạng")return;const on=$$("#revlist .rv").findIndex(e=>e.classList.contains("on"));if(on>=0)drawTo(on)})
 .observe($("#revlist"),{subtree:true,attributes:true,attributeFilter:["class"]});

/* Đường c/v trong mô phỏng: sợi chỉ thành đường cong */
(()=>{const p=$("#simA").closest(".panel");const w=document.createElement("div");w.id="cvw";p.append(w);
 const pts=[];for(let a=0;a<=100;a++){const o=window.__sim(a/100,false);pts.push([20+a*3.6,150-(o.r-1)/2.5*130])}
 const d="M"+pts.map(q=>q.map(v=>v.toFixed(1)).join(" ")).join(" L");
 const rEnd=window.__sim(1,false).r;
 w.innerHTML=`<svg viewBox="0 0 400 178" aria-label="Đường c/v tăng theo mức tự động hóa"><line class="ax" x1="20" y1="150" x2="380" y2="150"/><path class="cvg" d="${d}"/><path class="cv" d="${d}"/><circle class="hd" r="8" cx="20" cy="150"/><text x="20" y="172">0%</text><text x="380" y="172" text-anchor="end">100% tự động</text><text x="30" y="118">c/v = ${fmt(1,2)}</text><text class="re" x="372" y="10" text-anchor="end">c/v = ${fmt(rEnd,2)}</text></svg>`;
 const cv=$(".cv",w),hd=$(".hd",w),re=$(".re",w),L=[0];for(let i=1;i<pts.length;i++)L.push(L[i-1]+Math.hypot(pts[i][0]-pts[i-1][0],pts[i][1]-pts[i-1][1]));
 const upd=()=>{const a=Math.round(+$("#simA").value);gsap.set(cv,{drawSVG:`0 ${Math.max(.01,L[a])}`});hd.setAttribute("cx",pts[a][0]);hd.setAttribute("cy",pts[a][1]);re.style.opacity=a>=100?1:0};
 const base=runSim;window.runSim=function(){base();upd()};runSim=window.runSim;upd()})();

/* Chuyển slide: sợi chỉ rút ra, nội dung lùi sang trái, rồi slide mới hiện */
const show0=show;let busy=null;
window.show=function(i,st){show0(i,st);if(document.fonts&&document.fonts.status!=="loaded")document.fonts.ready.then(()=>{if(cur===i)enter(i)});else enter(i)};show=window.show;
const next0=next,prev0=prev;window.next=function(){if(busy){busy.progress(1);busy=null}next0()};next=window.next;
window.prev=function(){if(busy){busy.progress(1);busy=null}prev0()};prev=window.prev;
window.go=function(i){i=Math.max(0,Math.min(slides.length-1,i));if(busy){busy.progress(1);busy=null}if(i===cur)return;
 if(reduce){show(i);return}
 const s=slides[cur],kids=[...s.children].filter(e=>!e.matches(".notes,.foot,canvas#loom"));
 live.forEach(t=>t.kill());live=[];
 busy=gsap.timeline({onComplete(){busy=null;gsap.set(kids,{clearProps:"opacity,transform"});show(i)}})
  .to($$("path",svg),{drawSVG:"100% 100%",duration:.42,ease:"power2.in"},0)
  .to([head,...nodes],{opacity:0,duration:.25},0)
  .to(kids,{x:-36,opacity:0,duration:.3,stagger:.025,ease:"power2.in"},.05)};go=window.go;
addEventListener("resize",()=>{if(!busy)enter(cur)});
enter(cur);
})();
</script>
